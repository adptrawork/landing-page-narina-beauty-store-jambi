---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
import { business, waLink, socials } from '../data/business';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; crumbs?: { name: string; path: string }[]; faqs?: { q: string; a: string }[]; }
const { title, description, canonicalPath = '/', image, crumbs, faqs } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://narinabeauty-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
const cta = waLink(`Halo ${business.name}, saya mau tanya stok produk. Apakah ready?`);
const path = Astro.url.pathname;
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
const linkCls = (h: string) =>
  active(h) ? 'text-accent font-semibold' : 'text-ink/75 hover:text-accent transition-colors';
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog', label: 'Katalog' },
  { href: '/promo', label: 'Promo' },
  { href: '/tentang', label: 'Tentang' },
];
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} crumbs={crumbs} faqs={faqs} />
</head>
<body class="bg-paper text-ink antialiased">
  <a class="skip-link" href="#main">Lompat ke konten utama</a>
  <!-- Ref: NAP konsisten (alamat/jam/WA) — satu sumber kebenaran di business.ts -->
  <div class="bg-paper-2 text-ink border-b border-moss/30 text-xs">
    <p class="max-w-6xl mx-auto px-4 py-2 leading-relaxed">
      <span class="block sm:inline">{business.address}</span>
      <span class="hidden sm:inline" aria-hidden="true"> &middot; </span>
      <span class="block sm:inline">{business.hours}</span>
      <span class="hidden sm:inline" aria-hidden="true"> &middot; </span>
      <span class="block sm:inline">WA {business.phoneDisplay}</span>
    </p>
  </div>
  <header class="sticky top-0 z-40 bg-paper/90 backdrop-blur-md border-b border-moss/30">
    <nav class="max-w-6xl mx-auto grid grid-cols-[1fr_auto] md:grid-cols-[auto_1fr_auto] items-center gap-3 px-4 py-3" aria-label="Navigasi utama">
      <a href="/" class="min-w-0">
        <span class="block font-display text-2xl leading-none">Narina</span>
        <span class="block mt-0.5 text-[11px] font-medium tracking-[0.2em] uppercase text-moss-ink">Beauty Store &middot; Thehok</span>
      </a>
      <div class="hidden md:flex justify-center gap-7 text-[15px]">
        {nav.map((n) => (<a href={n.href} class={linkCls(n.href)} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>))}
      </div>
      <div class="flex items-center justify-end gap-2">
        <a href={cta} target="_blank" rel="noopener" class="hidden sm:inline-flex bg-accent text-paper px-5 py-3 min-h-[44px] items-center rounded-full text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition">Tanya stok</a>
        <!-- Hamburger 44px, aman sampai 360px -->
        <button id="burger" type="button" class="md:hidden inline-flex items-center justify-center w-11 h-11 min-w-[44px] min-h-[44px] rounded-full border border-moss/50 text-ink" aria-label="Buka menu navigasi">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </nav>
    <nav id="mnav" class="md:hidden hidden border-t border-moss/30 bg-paper" aria-label="Navigasi seluler">
      <div class="max-w-6xl mx-auto grid px-4 py-2 text-[15px]">
        {nav.map((n) => (
          <a href={n.href} class={`py-3 min-h-[48px] inline-flex items-center border-b border-moss/20 ${active(n.href) ? 'text-accent font-semibold' : 'text-ink/80'}`} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <a href={cta} target="_blank" rel="noopener" class="my-3 bg-accent text-paper px-5 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold">Tanya stok via WhatsApp</a>
      </div>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <!-- Ref: footer NAP ringkas + kredit gambar (sumber tercatat di README repo) -->
  <footer class="mt-16 md:mt-24 border-t border-moss/30 bg-paper-2">
    <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-8 min-w-0">
        <p class="font-display text-2xl">Narina Beauty Store</p>
        <p class="mt-3 text-[15px] leading-relaxed max-w-[65ch] text-ink">{business.address}</p>
        <p class="mt-1 text-[15px] leading-relaxed text-ink-soft">{business.hours} &middot; {business.category} &middot; {business.city}</p>
        <div class="mt-5 grid sm:flex gap-x-5 gap-y-1 text-sm">
          <a href="/katalog" class="text-accent underline underline-offset-4 decoration-accent/50 min-h-[44px] inline-flex items-center">Katalog</a>
          <a href="/promo" class="text-accent underline underline-offset-4 decoration-accent/50 min-h-[44px] inline-flex items-center">Promo</a>
          <a href="/tentang" class="text-accent underline underline-offset-4 decoration-accent/50 min-h-[44px] inline-flex items-center">Tentang &amp; kontak</a>
        </div>
        <p class="mt-6 text-xs leading-relaxed text-ink-soft max-w-[72ch]">
          Kredit gambar: beberapa foto produk dari situs resmi brand (skintific.com, glad2glow.com, facetology.id, eminacosmetics.com);
          sebagian lain ilustrasi generik dari <a href="https://commons.wikimedia.org" target="_blank" rel="noopener" class="underline underline-offset-2">Wikimedia Commons</a> (CC BY / CC BY-SA) &mdash; bukan foto toko atau produk bermerek terkait. Daftar lengkap per file ada di README repositori.
        </p>
      </div>
      <div class="md:col-span-4">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Hubungi</p>
        <div class="mt-4 grid gap-2 text-sm">
          <a href={cta} target="_blank" rel="noopener" class="text-ink underline underline-offset-4 decoration-moss/60 min-h-[44px] inline-flex items-center">WhatsApp {business.phoneDisplay}</a>
          <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-ink underline underline-offset-4 decoration-moss/60 min-h-[44px] inline-flex items-center">Google Maps &mdash; rute ke lokasi</a>
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" class={`text-ink underline underline-offset-4 decoration-moss/60 min-h-[44px] inline-flex items-center`}>{s.label}</a>
          ))}
        </div>
        <p class="mt-6 text-xs text-ink-soft">&copy; 2026 {business.name} &mdash; {business.city}.</p>
      </div>
    </div>
  </footer>
  <script is:inline>
    (function(){var b=document.getElementById('burger'),n=document.getElementById('mnav');if(b&&n)b.addEventListener('click',function(){var o=n.classList.toggle('hidden');b.setAttribute('aria-expanded',String(!o));b.setAttribute('aria-label',o?'Buka menu navigasi':'Tutup menu navigasi');});document.addEventListener('click',function(e){var t=e.target;if(!t||!t.hasAttribute||!t.hasAttribute('data-loadmap'))return;var x=t.closest('[data-embed]');if(!x)return;var f=document.createElement('iframe');f.src=x.getAttribute('data-embed');f.title=x.getAttribute('data-title')||'Peta lokasi';f.loading='lazy';f.className='w-full h-full';x.textContent='';x.appendChild(f);});})();
  </script>
</body>
</html>
