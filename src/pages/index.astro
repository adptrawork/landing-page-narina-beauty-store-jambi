---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeedsSteps from '../components/NeedsSteps.astro';
import ProductRack from '../components/ProductRack.astro';
import Faq from '../components/Faq.astro';
import StoreFacts from '../components/StoreFacts.astro';
import MapFacade from '../components/MapFacade.astro';
import { business, products, waLink } from '../data/business';

const wa = waLink(`Halo ${business.name}, saya mau tanya stok dan rekomendasi produk.`);
const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const featured = products.slice(0, 5);

const steps = [
  { t: 'Kenali jenis kulit', d: 'Kering, berminyak, kombinasi, atau sensitif? Catat keluhan utama (kusam, jerawat, atau kering) sebelum memilih.' },
  { t: 'Pilih rangkaian seperlunya', d: 'Mulai dari pembersih, pelembap, lalu tabir surya. Tambah serum atau perawatan lain hanya bila memang dibutuhkan.' },
  { t: 'Rutin dan evaluasi', d: 'Pakai konsisten 4–6 minggu, catat perubahan, lalu sesuaikan. Bingung? Minta rekomendasi admin via WhatsApp.' },
];

const faqs = [
  {
    q: 'Bagaimana cara memilih produk yang cocok?',
    a: 'Mulai dari kebutuhan kulitmu: bersihkan, lembapkan, lindungi. Gunakan tiga langkah di atas sebagai panduan, lalu tanyakan varian yang tepat ke admin via WhatsApp agar tidak salah beli.',
  },
  {
    q: 'Bagaimana memastikan produk asli?',
    a: 'Status tiap item ditandai di katalog. Label Teruji berarti data produk dicek dari sumber resmi brand; Estimasi berarti perkiraan. Untuk nomor legalitas atau registrasi per item, konfirmasi langsung ke admin atau periksa kemasan saat membeli.',
  },
  {
    q: 'Bisa kirim ke luar kota atau jadi reseller?',
    a: 'Bisa. Toko melayani ecer, grosir, dan reseller. Untuk pengiriman luar kota, harga grosir, dan syarat reseller, hubungi admin via WhatsApp untuk info terbaru.',
  },
  {
    q: 'Bagaimana cara pesan?',
    a: 'Pilih produk di katalog, tekan Tanya stok, lalu kirim pesan ke WhatsApp admin. Admin mengonfirmasi stok dan harga final sebelum kamu bayar atau mengambil di toko.',
  },
];

const title = 'Narina Beauty Store Jambi — Skincare & Kosmetik Thehok';
const description =
  'Narina Beauty Store di Jl Jend Sudirman Thehok, Jambi: layanan ecer, grosir & reseller skincare dan kosmetik. Cek stok beserta harga via WhatsApp admin.';
---
<BaseLayout title={title} description={description} canonicalPath="/" faqs={faqs}>
  <!-- Ref: botanical editorial, kolase asimetris + langkah bernomor -->
  <!-- 01 HERO — kolase foto asimetris (bukan hero tengah) -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-16 pb-10 md:min-h-[100dvh] md:grid md:content-center">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12 items-center">
      <div class="md:col-span-6 min-w-0">
        <p class="reveal flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink" style="--i:0">
          <span>{business.category}</span>
          <span class="text-moss/60" aria-hidden="true">&bull;</span>
          <span>{business.city}</span>
        </p>
        <h1 class="reveal mt-5 font-display text-4xl sm:text-5xl md:text-6xl leading-[1.03] max-w-[16ch]" style="--i:1">
          Rak kurasi skincare dan kosmetik pilihan di Thehok, Jambi
        </h1>
        <p class="reveal mt-6 text-base md:text-lg leading-relaxed text-ink-soft max-w-[52ch]" style="--i:2">
          Narina Beauty Store merawat kebutuhan kulit harianmu &mdash; dari pembersih, pelembap, dan tabir surya sampai lip cream.
          Telusuri rak, lalu konfirmasi stok dan harga via WhatsApp admin sebelum berkunjung.
        </p>
        <div class="reveal mt-8" style="--i:3">
          <a href={wa} target="_blank" rel="noopener" class="bg-accent text-paper px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:opacity-90 active:scale-[0.98] transition">Tanya stok via WhatsApp</a>
        </div>
        <p class="reveal mt-5 text-sm text-ink-soft max-w-[52ch]" style="--i:4">
          {business.address} &middot; {business.hours}
        </p>
      </div>

      <!-- Kolase: satu foto tinggi 3:4 + satu kotak 1:1 + satu 4:5; runtuh 1 kolom < 768px -->
      <div class="reveal md:col-span-6 min-w-0" style="--i:2">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
          <div class="md:row-span-2 rounded-3xl overflow-hidden bg-paper-2">
            <img src="/images/narina-p1.jpg" alt="Skintific 5X Ceramide Barrier Repair Moisture Gel — foto resmi brand" width="800" height="800" loading="eager" fetchpriority="high" decoding="async" class="photo-fade w-full aspect-[3/4] md:aspect-[4/5] object-cover" />
          </div>
          <div class="rounded-3xl overflow-hidden bg-paper-2">
            <img src="/images/narina-hero.jpg" alt="Foto profil resmi Narina Beauty Store dari akun toko" width="400" height="400" loading="eager" decoding="async" class="w-full aspect-square object-cover" />
          </div>
          <div class="hidden md:block rounded-3xl overflow-hidden bg-paper-2">
            <img src="/images/narina-p3.jpg" alt="Facetology Triple Care Sunscreen SPF 40 — foto resmi brand" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover" />
          </div>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-ink-soft">
          Foto produk: situs resmi brand (skintific.com, facetology.id) dan foto profil toko. Bukan foto etalase terkini &mdash; kredit lengkap di README.
        </p>
      </div>
    </div>
  </section>

  <!-- 02 TIGA LANGKAH KEBUTUHAN -->
  <section aria-label="Tiga langkah kebutuhan" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-moss/30">
    <NeedsSteps steps={steps} />
  </section>

  <!-- 03 KATALOG SOROTAN — rak ber-rule, bukan grid 3 kolom sama -->
  <section aria-label="Sorotan katalog" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-moss/30">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end">
      <div class="md:col-span-8 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Sorotan rak &middot; <span class="font-mono-num">{products.length} produk</span></p>
        <h2 class="mt-3 font-display text-3xl md:text-5xl leading-[1.05] max-w-[24ch]">Beberapa yang paling sering ditanyakan</h2>
      </div>
      <p class="md:col-span-4 md:text-right text-sm leading-relaxed text-ink-soft">
        Harga di situs ini <strong class="text-ink">estimasi</strong> &mdash; stok dan harga final dikonfirmasi admin via WhatsApp.
      </p>
    </div>
    <div class="mt-8">
      <ProductRack items={featured} />
    </div>
    <a href="/katalog" class="mt-8 inline-flex items-center gap-2 font-semibold text-accent underline underline-offset-4 decoration-accent/40 min-h-[44px]">
      Lihat semua {products.length} produk di katalog
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </section>

  <!-- Ref: botanical editorial, blok edukasi zig-zag 2 kolom + motif botani -->
  <!-- 04 EDUKASI BOTANI & BAHAN -->
  <section aria-label="Edukasi bahan" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-moss/30">
    <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Catatan botani &amp; bahan</p>
    <h2 class="mt-3 font-display text-3xl md:text-4xl leading-[1.08] max-w-[24ch]">Sedikit bekal sebelum memilih produk</h2>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 items-center">
      <div class="min-w-0">
        <h3 class="font-display text-2xl leading-snug">Bahan penenang dan bahan aktif tidak diperlakukan sama</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ink-soft max-w-[52ch]">
          Bahan penenang seperti centella dan ceramide umumnya dipakai untuk menjaga kelembapan dan kenyamanan kulit.
          Bahan aktif seperti AHA, BHA, atau retinol bekerja lebih keras &mdash; perkenalkan perlahan, satu per satu,
          dan hindari menumpuk banyak produk baru sekaligus.
        </p>
      </div>
      <figure class="min-w-0">
        <div class="rounded-3xl overflow-hidden bg-paper-2">
          <img src="/images/narina-p2.jpg" alt="Glad2Glow Centella Allantoin Soothing Gel Moisturizer — foto resmi brand" width="800" height="800" loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover" />
        </div>
        <figcaption class="mt-2 text-xs text-ink-soft">Ilustrasi bahan: foto resmi brand (glad2glow.com). Catatan ini bersifat umum, bukan saran medis.</figcaption>
      </figure>
    </div>

    <div class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 items-center">
      <div class="min-w-0 md:order-2">
        <h3 class="font-display text-2xl leading-snug">Tabir surya bagian dari rutinitas, bukan tambahan</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ink-soft max-w-[52ch]">
          Pakai tabir surya di pagi hari sebagai langkah terakhir perawatan, dan ulangi saat beraktivitas lama di luar ruangan.
          Pilih varian yang nyaman dipakai setiap hari &mdash; konsistensi lebih penting daripada banyak produk.
        </p>
      </div>
      <figure class="min-w-0 md:order-1">
        <div class="rounded-3xl bg-blush p-8 md:p-10 grid place-content-center min-h-[220px]">
          <svg viewBox="0 0 200 260" class="w-32 sm:w-40 text-ink" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Ilustrasi garis tangkai tanaman dengan daun">
            <path d="M100 250V46" />
            <path d="M100 118c-26-6-44-26-46-52 26 4 44 24 46 52Z" />
            <path d="M100 118c26-6 44-26 46-52-26 4-44 24-46 52Z" />
            <path d="M100 172c-30-6-50-28-52-58 30 4 50 26 52 58Z" />
            <path d="M100 172c30-6 50-28 52-58-30 4-50 26-52 58Z" />
            <path d="M100 226c-22-5-36-20-38-40 22 3 36 18 38 40Z" />
            <path d="M100 226c22-5 36-20 38-40-22 3-36 18-38 40Z" />
            <path d="M100 46c-10-8-10-24 0-32 10 8 10 24 0 32Z" />
          </svg>
        </div>
        <figcaption class="mt-2 text-xs text-ink-soft">Motif botani garis, bukan foto lokasi toko.</figcaption>
      </figure>
    </div>
  </section>

  <!-- 05 FAQ ACCORDION -->
  <section aria-label="Pertanyaan umum" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-moss/30">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-5 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">FAQ</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl leading-[1.05] max-w-[18ch]">Pertanyaan yang sering muncul</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-soft max-w-[44ch]">Belum terjawab? Chat admin via WhatsApp, dibalas saat jam buka toko.</p>
      </div>
      <div class="md:col-span-7 min-w-0">
        <Faq faqs={faqs} />
      </div>
    </div>
  </section>

  <!-- 06 INFO TOKO — <dl> ber-rule, hanya field dari business.ts -->
  <section aria-label="Info toko" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-moss/30">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-4 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Info toko</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl leading-[1.05] max-w-[16ch]">Berkunjung atau tanya dulu</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-soft max-w-[40ch]">Status data ditandai apa adanya: <strong class="text-ink">Terverifikasi</strong> untuk yang sudah dicek, <strong class="text-ink">Estimasi</strong> untuk perkiraan.</p>
      </div>
      <div class="md:col-span-8 min-w-0">
        <StoreFacts />
      </div>
    </div>
  </section>

  <!-- 07 LOKASI — MapFacade klik-untuk-muat + CTA WhatsApp -->
  <section aria-label="Lokasi" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-moss/30">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
      <div class="md:col-span-5 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Lokasi</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl leading-[1.05] max-w-[16ch]">Deretan Transmart, Thehok</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-soft max-w-[44ch]">{business.address}</p>
        <p class="mt-1 font-mono-num text-sm text-moss-ink">{business.hours}</p>
        <div class="mt-6 grid sm:flex gap-3">
          <a href={wa} target="_blank" rel="noopener" class="text-center bg-accent text-paper px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition">Chat WhatsApp</a>
          <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-center border border-ink/30 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Buka di Google Maps</a>
        </div>
      </div>
      <div class="md:col-span-7 min-w-0">
        <MapFacade embed={embed} />
      </div>
    </div>
  </section>
</BaseLayout>
