---
import BaseLayout from '../layouts/BaseLayout.astro';
import NeedsSteps from '../components/NeedsSteps.astro';
import { business, promos, waLink } from '../data/business';

const steps = [
  { t: 'Pilih tier promo', d: 'Cocokkan kebutuhanmu dengan tier di atas &mdash; catat judul promonya.' },
  { t: 'Klik klaim via WA', d: 'Tombol klaim menyiapkan format chat otomatis berisi judul promo yang kamu pilih.' },
  { t: 'Konfirmasi admin', d: 'Admin memastikan promo masih berlaku dan menyebutkan harga final sebelum kamu bayar.' },
];
const title = 'Promo Bundling & Reseller Narina Beauty Store Jambi';
const description =
  'Promo bundling dan program reseller Narina Beauty Store Jambi. Status estimasi, konfirmasi ketersediaan dan harga final lewat WhatsApp toko.';
const crumbs = [
  { name: 'Beranda', path: '/' },
  { name: 'Promo', path: '/promo' },
];
---
<BaseLayout title={title} description={description} canonicalPath="/promo" crumbs={crumbs}>
  <!-- Ref: botanical editorial — tier promo sebagai daftar ber-rule bernomor (bukan 3 kartu sama besar) -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-16 pb-8">
    <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Promo &middot; <span class="font-mono-num">{promos.length} tier</span></p>
    <h1 class="mt-4 font-display text-4xl sm:text-5xl md:text-6xl leading-[1.03] max-w-[18ch]">Bundling &amp; program reseller</h1>
    <p class="mt-5 text-base md:text-lg leading-relaxed text-ink-soft max-w-[56ch]">
      Status tiap promo ditulis apa adanya. Semua harga <strong class="text-ink">estimasi</strong> &mdash; ketersediaan dan harga final wajib dikonfirmasi via WhatsApp sebelum order.
    </p>
  </section>

  <section aria-label="Daftar promo" class="max-w-6xl mx-auto px-4 pb-8">
    <ol class="divide-y divide-moss/30 border-y border-moss/40">
      {promos.map((m, i) => (
        <li class="grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-8 py-7 min-w-0">
          <div class="md:col-span-3 min-w-0">
            <p class="font-display text-4xl leading-none text-blush md:text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <p class="mt-3 text-[11px] font-semibold tracking-[0.16em] uppercase text-moss-ink max-w-[28ch]">{m.status}</p>
          </div>
          <div class="md:col-span-7 min-w-0">
            <h2 class="font-display text-2xl md:text-3xl leading-snug">{m.title}</h2>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft max-w-[56ch]">{m.desc}</p>
          </div>
          <div class="md:col-span-2 md:text-right">
            <a href={waLink(`Halo ${business.name}, saya mau klaim promo: ${m.title}. Apakah masih berlaku?`)} target="_blank" rel="noopener" class="inline-flex items-center justify-center border border-ink/25 px-5 py-2.5 min-h-[44px] rounded-full text-sm font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Klaim via WA</a>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- CARA KLAIM -->
  <section aria-label="Cara klaim" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-moss/30">
    <NeedsSteps steps={steps} kicker="Cara klaim" title="Tiga langkah mengklaim promo" desc="Tidak ada langkah tersembunyi &mdash; semua lewat WhatsApp admin supaya status promo jelas." />
  </section>

  <!-- DISCLAIMER -->
  <section aria-label="Catatan" class="max-w-6xl mx-auto px-4 py-12 md:py-16 border-t border-moss/30">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12">
      <div class="md:col-span-4 min-w-0">
        <h2 class="font-display text-2xl md:text-3xl leading-snug">Catatan promosi</h2>
      </div>
      <div class="md:col-span-8 min-w-0">
        <p class="text-[15px] leading-relaxed text-ink-soft max-w-[64ch]">
          Harga dapat berubah dan promo dapat berakhir sewaktu-waktu mengikuti kebijakan toko. Halaman ini bukan bukti klaim harga.
          Untuk status terbaru, cek <a href={business.instagram} target="_blank" rel="noopener" class="text-accent underline underline-offset-4 decoration-accent/50">Instagram toko</a> atau tanya admin via WhatsApp.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
