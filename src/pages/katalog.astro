---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductRack from '../components/ProductRack.astro';
import { business, products, waLink } from '../data/business';

const wa = waLink(`Halo ${business.name}, saya cari produk lain. Boleh info katalog lengkap?`);
const badges = ['Semua', ...Array.from(new Set(products.map((p) => p.badge)))];
const title = 'Katalog Skincare & Kosmetik Narina Beauty Store Jambi';
const description =
  'Katalog produk Narina Beauty Store Jambi: harga estimasi per item, label Teruji dan Estimasi, pesan langsung via WhatsApp admin.';
const crumbs = [
  { name: 'Beranda', path: '/' },
  { name: 'Katalog', path: '/katalog' },
];
---
<BaseLayout title={title} description={description} canonicalPath="/katalog" crumbs={crumbs}>
  <!-- Ref: botanical editorial — rak katalog ber-rule + filter label, bukan grid kartu -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-16 pb-8">
    <nav aria-label="Remah" class="text-xs text-ink-soft">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="underline underline-offset-4 decoration-moss/50 hover:decoration-accent">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-moss-ink">Katalog</li>
      </ol>
    </nav>
    <p class="mt-6 text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Katalog &middot; <span class="font-mono-num">{products.length} produk</span></p>
    <h1 class="mt-4 font-display text-4xl sm:text-5xl md:text-6xl leading-[1.03] max-w-[18ch]">Semua produk di rak Narina Beauty Store</h1>
    <p class="mt-5 text-base md:text-lg leading-relaxed text-ink-soft max-w-[56ch]">
      Harga di sini <strong class="text-ink">estimasi</strong>. Label <strong class="text-ink">Teruji</strong> berarti data produk dicek dari sumber resmi brand;
      <strong class="text-ink">Estimasi</strong> berarti perkiraan. Stok dan harga final selalu dikonfirmasi admin via WhatsApp.
    </p>

    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Saring produk berdasarkan label">
      {badges.map((b, i) => (
        <button type="button" data-filter={b} aria-pressed={i === 0 ? 'true' : 'false'} class="filter-btn border border-moss/50 px-5 py-2.5 min-h-[44px] rounded-full text-sm font-medium transition-colors active:scale-[0.98]">{b}</button>
      ))}
    </div>
    <p id="filter-count" class="mt-4 font-mono-num text-xs tracking-[0.16em] uppercase text-moss-ink" aria-live="polite"></p>
  </section>

  <section aria-label="Daftar produk" class="max-w-6xl mx-auto px-4 pb-8">
    <div id="rack">
      <ProductRack items={products} showSource titleTag="h2" />
    </div>

    <div id="empty" class="hidden py-14 text-center min-w-0">
      <svg class="mx-auto text-moss-ink" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5M8 11h6" /></svg>
      <p class="mt-4 font-display text-2xl">Tidak ada produk pada label ini</p>
      <p class="mt-2 text-[15px] text-ink-soft max-w-[48ch] mx-auto">Coba label lain, atau tanyakan katalog lengkap lewat WhatsApp admin.</p>
      <a href={wa} target="_blank" rel="noopener" class="mt-5 bg-accent text-paper px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold active:scale-[0.98] transition">Tanya via WhatsApp</a>
    </div>

    <p class="mt-10 text-[15px] leading-relaxed text-ink-soft">Belum menemukan yang dicari? <a class="text-accent underline underline-offset-4 decoration-accent/50" href={wa} target="_blank" rel="noopener">Tanya katalog lengkap via WhatsApp</a>.</p>
  </section>

  <!-- 07 ringkas: lokasi + CTA (di halaman katalog tetap sediakan jalur kontak) -->
  <section aria-label="Lokasi dan kontak" class="max-w-6xl mx-auto px-4 py-12 md:py-16 border-t border-moss/30">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
      <div class="md:col-span-5 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Beli di toko</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl leading-[1.05] max-w-[16ch]">Ambil langsung di Thehok</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-soft max-w-[44ch]">{business.address}</p>
        <p class="mt-1 font-mono-num text-sm text-moss-ink">{business.hours}</p>
        <a href={wa} target="_blank" rel="noopener" class="mt-6 bg-accent text-paper px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition">Tanya stok via WhatsApp</a>
      </div>
      <div class="md:col-span-7 min-w-0">
        <p class="text-[15px] leading-relaxed text-ink-soft max-w-[56ch]">Semua produk yang dijual di toko bisa dicari lebih dulu lewat WhatsApp, jadi kamu datang tinggal mengambil.
        Ingin lihat halaman lain? Buka <a href="/promo" class="text-accent underline underline-offset-4 decoration-accent/50">promo</a> atau <a href="/tentang" class="text-accent underline underline-offset-4 decoration-accent/50">info toko</a>.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    (function(){var b=document.querySelectorAll('.filter-btn'),r=document.querySelectorAll('#rack [data-badge]'),c=document.getElementById('filter-count'),e=document.getElementById('empty');function apply(f){var n=0;r.forEach(function(x){var s=f==='Semua'||x.getAttribute('data-badge')===f;x.style.display=s?'':'none';if(s)n++;});if(c)c.textContent=n?'Menampilkan '+n+' dari '+r.length+' produk':'Tidak ada produk pada label ini';if(e)e.classList.toggle('hidden',n>0);b.forEach(function(x){x.setAttribute('aria-pressed',x.getAttribute('data-filter')===f?'true':'false');});}b.forEach(function(x){x.addEventListener('click',function(){apply(x.getAttribute('data-filter')||'Semua');});});apply('Semua');})();
  </script>
</BaseLayout>
