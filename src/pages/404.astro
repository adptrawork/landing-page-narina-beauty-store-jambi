---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, waLink } from '../data/business';

const wa = waLink('Halo Narina Beauty Store, saya butuh bantuan rute atau stok produk.');
const title = '404 — Halaman tidak ditemukan | Narina Beauty Store Jambi';
const description =
  'Halaman tidak ditemukan di situs Narina Beauty Store Jambi. Gunakan beranda atau katalog skincare Thehok, lalu tanya stok dan rute via WhatsApp admin.';
---

<BaseLayout title={title} description={description} canonicalPath="/404">
  <!-- Ref: botanical editorial, state kosong aksesibel + jalur kontak -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-16 pb-12 md:min-h-[70dvh] grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    <div class="md:col-span-7 min-w-0">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">404 &middot; Tidak ditemukan</p>
      <h1 class="mt-3 font-display text-4xl sm:text-5xl md:text-6xl leading-[1.03] max-w-[18ch]">Halaman tidak ditemukan</h1>
      <p class="mt-5 text-base md:text-lg leading-relaxed text-ink-soft max-w-[52ch]">
        Tautan mungkin berubah atau sudah dipindahkan. Kembali ke beranda, telusuri katalog skincare, atau tanya rute langsung ke admin.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/" class="bg-accent text-paper px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition">Beranda</a>
        <a href="/katalog" class="border border-ink/25 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Katalog</a>
        <a href="/tentang" class="border border-ink/25 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Tentang &amp; kontak</a>
      </div>
    </div>
    <div class="md:col-span-5 min-w-0">
      <div class="rounded-3xl border border-moss/40 bg-paper-2 p-8">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Hubungi toko</p>
        <p class="mt-3 font-display text-2xl leading-snug">Lewat WhatsApp admin</p>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-soft max-w-[44ch]">
          {business.address} &middot; {business.hours}
        </p>
        <a href={wa} target="_blank" rel="noopener" class="mt-5 bg-accent text-paper px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition">Chat WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>
