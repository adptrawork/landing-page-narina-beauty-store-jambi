---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreFacts from '../components/StoreFacts.astro';
import MapFacade from '../components/MapFacade.astro';
import { business, socials, storeNotes, waLink } from '../data/business';

const wa = waLink(`Halo ${business.name}, saya mau tanya stok, rute, dan jam buka.`);
const embed = `https://maps.google.com/maps?q=${encodeURIComponent(business.mapsQuery)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
const crumbs = [
  { name: 'Beranda', path: '/' },
  { name: 'Tentang', path: '/tentang' },
];
const title = 'Panduan, Alamat & Kontak Narina Beauty Store Jambi';
const description =
  'Alamat, jam buka, dan WhatsApp Narina Beauty Store di Jl Jend Sudirman Thehok Jambi. Stok dan harga final dikonfirmasi admin via WhatsApp.';
---

<BaseLayout title={title} description={description} canonicalPath="/tentang" crumbs={crumbs} image={business.ogImage}>
  <!-- Ref: botanical editorial, info toko ber-rule + peta facade -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-16 pb-8">
    <nav aria-label="Remah" class="text-xs text-ink-soft">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="underline underline-offset-4 decoration-moss/50 hover:decoration-accent">Beranda</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-moss-ink">Tentang</li>
      </ol>
    </nav>
    <p class="mt-6 text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Info toko</p>
    <h1 class="mt-4 font-display text-4xl sm:text-5xl md:text-6xl leading-[1.03] max-w-[18ch]">Alamat, jam buka, dan kontak Narina Beauty Store</h1>
    <p class="mt-5 text-base md:text-lg leading-relaxed text-ink-soft max-w-[56ch]">
      Narina Beauty Store di Jl Jend Sudirman Thehok, Kota Jambi. Data toko di sini hanya memakai yang sudah tercatat di situs,
      dan angka stok, harga final, atau rute sempurna selalu dikonfirmasi admin via WhatsApp sebelum kamu berkunjung.
    </p>
  </section>

  <section aria-label="Info toko lengkap" class="max-w-6xl mx-auto px-4 py-10 md:py-16 border-t border-moss/30">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-5 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Status data</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl leading-[1.05] max-w-[16ch]">Yang sudah dicatat dan yang perlu konfirmasi</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-soft max-w-[44ch]">
          Status <strong class="text-ink">Terverifikasi</strong> berarti data dicek dari sumber publik toko.
          <strong class="text-ink">Estimasi</strong> berarti perkiraan dari direktori dan harus dikonfirmasi ulang.
        </p>
      </div>
      <div class="md:col-span-7 min-w-0">
        <StoreFacts />
      </div>
    </div>
  </section>

  <section aria-label="Lokasi toko" class="max-w-6xl mx-auto px-4 py-10 md:py-16 border-t border-moss/30">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
      <div class="md:col-span-5 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Lokasi</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl leading-[1.05] max-w-[16ch]">Deretan Transmart, Thehok</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-soft max-w-[44ch]">{business.address}</p>
        <p class="mt-1 font-mono-num text-sm text-moss-ink">{business.hours}</p>
        <div class="mt-6 grid sm:flex gap-3">
          <a href={wa} target="_blank" rel="noopener" class="text-center bg-accent text-paper px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition">Chat WhatsApp</a>
          <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-center border border-ink/25 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Buka di Google Maps</a>
        </div>
      </div>
      <div class="md:col-span-7 min-w-0">
        <MapFacade embed={embed} />
      </div>
    </div>
  </section>

  <section aria-label="Akun resmi dan catatan toko" class="max-w-6xl mx-auto px-4 py-10 md:py-16 border-t border-moss/30">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-5 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-moss-ink">Akun resmi</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl leading-[1.05] max-w-[16ch]">Instagram, TikTok, dan Shopee</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-soft max-w-[44ch]">
          Tautan di bawah mengarah ke akun resmi toko. Catatan status dan pengikut tampilkan apa adanya pada kanal tersebut, bukan klaim situs ini.
        </p>
      </div>
      <div class="md:col-span-7 min-w-0">
        <ul class="divide-y divide-moss/30 border-y border-moss/40">
          {socials.map((s) => (
            <li class="py-4 grid grid-cols-1 sm:grid-cols-[8rem_1fr] gap-1 sm:gap-6">
              <span class="text-[11px] font-semibold tracking-[0.16em] uppercase text-moss-ink sm:pt-1.5">{s.label}</span>
              <a href={s.url} target="_blank" rel="noopener" class="underline underline-offset-4 decoration-moss/50 hover:decoration-accent text-ink break-words">
                {s.url.replace('https://', '')}
              </a>
            </li>
          ))}
        </ul>
        <ul class="mt-8 grid gap-2 text-[15px] leading-relaxed text-ink-soft max-w-[56ch]">
          {storeNotes.map((n) => (
            <li class="border-l-2 border-moss/50 pl-4">{n}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
