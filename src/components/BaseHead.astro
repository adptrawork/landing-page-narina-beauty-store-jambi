---
interface Crumb { name: string; path: string; }
interface Faq { q: string; a: string; }
interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  image?: string;
  crumbs?: Crumb[];
  faqs?: Faq[];
}
import { business } from '../data/business';
const { title, description, canonicalUrl, image = business.ogImage, crumbs, faqs } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://narinabeauty-jambi.pages.dev').replace(/\/$/, '');
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();
const trail = crumbs ?? [{ name: 'Beranda', path: '/' }];

/* JSON-LD: LocalBusiness (Store) + BreadcrumbList tetap utuh.
   aggregateRating sengaja dihapus — rating/ulasan tidak diverifikasi di sumber resmi. */
const graph: Array<Record<string, unknown>> = [
  {
    '@type': ['Store', 'LocalBusiness'],
    '@id': `${site}/#store`,
    name: business.name,
    url: site,
    image: ogImage,
    description,
    address: {
      '@type': 'PostalAddress',
      streetAddress: business.address,
      addressLocality: business.city,
      addressRegion: 'Jambi',
      addressCountry: 'ID',
    },
    telephone: `+${business.phone}`,
    openingHours: 'Mo-Su 09:00-22:00',
    areaServed: business.city,
    sameAs: [business.instagram],
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: trail.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: `${site}${c.path}`,
    })),
  },
];
if (faqs && faqs.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
const ld = { '@context': 'https://schema.org', '@graph': graph };

/* PERF: font non-blocking — preconnect + display=swap, tanpa @import */
const fontHref =
  'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@400;500;600&display=swap';
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href={fontHref} /></noscript>
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<meta property="og:type" content="website" />
<meta property="og:locale" content="id_ID" />
<meta property="og:site_name" content="Narina Beauty Store — Thehok, Kota Jambi" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content="Foto profil resmi Narina Beauty Store" />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
